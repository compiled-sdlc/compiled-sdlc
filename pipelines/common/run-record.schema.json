{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:compiled-sdlc:telemetry:1:run-record",
  "version": "1",
  "title": "Run record",
  "description": "What one {change request x arm x seed} cell produced. Written as record.json inside the cell's directory and appended to runs/index.jsonl. Token fields carry the OpenTelemetry generative-AI convention names where those exist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "change_request",
    "arm",
    "seed",
    "status",
    "started_at",
    "usage",
    "cost_usd"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^CR-[0-9]{3,}__[a-z_]+__seed[0-9]+$"},
    "change_request": {"type": "string", "pattern": "^CR-[0-9]{3,}$"},
    "arm": {"enum": ["baseline", "lcir", "lcir_no_ast", "compressed"]},
    "seed": {"type": "integer", "minimum": 1},
    "status": {
      "description": "completed and agent_failed are outcomes of the agent; aborted and budget_exhausted are outcomes of the apparatus and are never counted as agent failures.",
      "enum": [
        "completed",
        "agent_failed",
        "verification_failed",
        "aborted",
        "budget_exhausted"
      ]
    },
    "error_class": {
      "type": ["string", "null"],
      "enum": [
        "rate_limit",
        "credit_exhausted",
        "overloaded",
        "auth",
        "network",
        "timeout",
        "turn_budget",
        "cost_budget",
        "executor_crash",
        "setup_failed",
        "unknown",
        null
      ]
    },
    "error_detail": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string"},
    "request": {
      "description": "What the cell was asked to do and under what budget.",
      "type": "object",
      "properties": {
        "model": {"type": "string"},
        "max_turns": {"type": "integer", "minimum": 1},
        "wall_clock_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0},
        "tools": {"type": "array", "items": {"type": "string"}},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "model": {"type": "string"},
        "finish_reason": {"type": ["string", "null"]},
        "terminal_reason": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "reasoning_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {
          "description": "Included in output_tokens; reported separately, never priced twice.",
          "type": "integer",
          "minimum": 0
        },
        "cache_creation_input_tokens": {"type": "integer", "minimum": 0},
        "cache_read_input_tokens": {"type": "integer", "minimum": 0},
        "cache_creation_5m_tokens": {"type": "integer", "minimum": 0},
        "cache_creation_1h_tokens": {"type": "integer", "minimum": 0},
        "api_calls": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "turns": {"type": "integer", "minimum": 0},
    "tool_calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_name"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "by_name": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "retries": {
      "description": "API calls the executor retried, counted from the transcript. A lower bound: only retries the transcript reports are visible.",
      "type": "integer",
      "minimum": 0
    },
    "permission_denials": {"type": "integer", "minimum": 0},
    "wall_time_seconds": {"type": "number", "minimum": 0},
    "api_time_seconds": {"type": "number", "minimum": 0},
    "cost_usd": {
      "description": "Recomputed from the token counts above and the captured price table. This is the measurement.",
      "type": "number",
      "minimum": 0
    },
    "executor_reported_cost_usd": {
      "description": "What the executor said it spent. Recorded for comparison, never used as the measurement.",
      "type": ["number", "null"],
      "minimum": 0
    },
    "pricing_captured_on": {"type": "string"},
    "workspace": {
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "base_commit": {"type": "string"},
        "files_changed": {"type": "integer", "minimum": 0},
        "insertions": {"type": "integer", "minimum": 0},
        "deletions": {"type": "integer", "minimum": 0},
        "changed_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "description": "Applied by the harness after the agent has finished, from material the agent never saw.",
      "type": "object",
      "properties": {
        "verified_success": {"type": "boolean"},
        "acceptance": {
          "type": "object",
          "properties": {
            "status": {"enum": ["pass", "fail", "error", "not_run"]},
            "checks": {"type": "array", "items": {"type": "object"}},
            "duration_seconds": {"type": "number", "minimum": 0}
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "status"],
            "properties": {
              "id": {"type": "string"},
              "kind": {"type": "string"},
              "status": {"enum": ["pass", "fail", "error", "not_run"]},
              "detail": {"type": "string"}
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "transcript": {"type": "string"},
        "stderr": {"type": "string"},
        "diff": {"type": "string"}
      }
    },
    "verified_success": {"type": "boolean"}
  }
}
