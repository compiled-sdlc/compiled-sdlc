{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:compiled-sdlc:lifecycle-ir:0.1:bundle",
  "version": "0.1.0",
  "title": "Lifecycle IR bundle manifest",
  "description": "The container that makes one change request's five structures a single verifiable unit. A bundle is a directory holding this manifest and the five documents it names; every document must declare the same IR version and change request as the manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "ir_version", "change_request", "title", "documents"],
  "properties": {
    "kind": {"const": "lifecycle_ir_bundle"},
    "ir_version": {"$ref": "urn:compiled-sdlc:lifecycle-ir:0.1:common#/$defs/irVersion"},
    "change_request": {"$ref": "urn:compiled-sdlc:lifecycle-ir:0.1:common#/$defs/changeRequest"},
    "title": {"$ref": "urn:compiled-sdlc:lifecycle-ir:0.1:common#/$defs/text"},
    "description": {"type": "string"},
    "created_at": {"$ref": "urn:compiled-sdlc:lifecycle-ir:0.1:common#/$defs/timestamp"},
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_graph", "constraint_graph", "transformation_plan", "evidence_graph", "provenance_ledger"],
      "properties": {
        "intent_graph": {"$ref": "#/$defs/documentPath"},
        "constraint_graph": {"$ref": "#/$defs/documentPath"},
        "transformation_plan": {"$ref": "#/$defs/documentPath"},
        "evidence_graph": {"$ref": "#/$defs/documentPath"},
        "provenance_ledger": {"$ref": "#/$defs/documentPath"}
      }
    }
  },
  "$defs": {
    "documentPath": {
      "description": "Path to a document, relative to the bundle directory.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
    }
  }
}
